---
import Base from '../layouts/Base.astro';
import SecurityDiagram from '../components/SecurityDiagram.astro';
import { profile, profileStory, skills, certifications } from '../data/profile';
import { BASE } from '../lib/base';
---

<Base
  title="About Trent Shelton | Red Brixen Security"
  description="Meet Trent Shelton: a security-focused software engineer working across penetration testing, secure coding, backend systems, and technical instruction."
>
  <section class="profile-hero shell">
    <p class="eyebrow">THE PERSON BEHIND RED BRIXEN</p>
    <div class="profile-intro">
      <div>
        <h1>
          Trent Shelton<span class="accent">.</span>
        </h1>
        <p class="profile-lead">
          An offensive perspective.
          <br />
          <em>An engineer’s understanding.</em>
        </p>
      </div>
      <div class="identity-mark" aria-hidden="true">
        <span>TS</span>
        <p>SECURITY / SOFTWARE / CURIOSITY</p>
      </div>
    </div>
    <div class="profile-meta">
      <span>MEMPHIS, TENNESSEE</span>
      <span>PENETRATION TESTING + SECURE CODING</span>
      <a href={BASE + '/resume/'}>VIEW RÉSUMÉ ↗</a>
    </div>
  </section>
  <section class="bio-section shell section-space">
    <p class="eyebrow">01 / BACKGROUND</p>
    <div class="prose">
      <h2>
        Understanding a system
        <br />
        means questioning it.
      </h2>
      <p class="lead">{profile.introduction}</p>
      <p>
        My engineering background spans backend services, APIs, enterprise
        integrations, and database-driven applications. Working on these systems
        has shaped the way I think about security: follow the data, understand
        the trust boundaries, and get close to the code.
      </p>
      <p>
        That perspective carries into secure code review, authorization
        improvements, dependency management, and vulnerability remediation.
        Penetration testing adds another lens—a way to question what a system
        assumes and explore where those assumptions can fail.
      </p>
      <p>
        I also value making technical ideas useful to other people. Instruction
        and mentorship are part of my background, alongside the practical work
        of building and securing software.
      </p>
    </div>
  </section>
  <section class="skills-section shell section-space">
    <div class="section-heading">
      <p class="eyebrow">02 / AREAS OF FOCUS</p>
      <h2>
        Depth in security.
        <br />
        Grounded in engineering.
      </h2>
    </div>
    <div class="profile-skills-layout">
      <div class="skills-grid">
        {skills.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <p>{group.items}</p>
          </div>
        ))}
      </div>
      <SecurityDiagram />
    </div>
  </section>
  <section id="experience" class="experience-section shell section-space">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">03 / THE STORY SO FAR</p>
        <h2>Curiosity. Craft. Shared knowledge.</h2>
      </div>
      <a class="text-link" href={BASE + '/resume/'}>
        Full résumé <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="experience-list">
      {profileStory.map((chapter) => (
        <article>
          <p class="eyebrow">{chapter.chapter}</p>
          <div>
            <h3>{chapter.title}</h3>
            {chapter.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="credentials-section shell section-space">
    <div class="section-heading">
      <p class="eyebrow">04 / CREDENTIALS & LEARNING</p>
      <h2>Practice. Learn. Repeat.</h2>
    </div>
    <div class="credentials-grid">
      {certifications.map((credential) => (
        <article>
          <h3>{credential.name}</h3>
          <p>{credential.issuer}</p>
          {credential.detail && (
            <p class="credential-detail">{credential.detail}</p>
          )}
          {credential.href && (
            <a class="text-link" href={credential.href}>
              Verify credential <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </section>
  <section class="contact-section shell">
    <p class="eyebrow">CONTINUE THE CONVERSATION</p>
    <div>
      <h2>
        Always curious.
        <br />
        Always building.
      </h2>
      <a class="button button-outline" href={BASE + '/contact/'}>
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>

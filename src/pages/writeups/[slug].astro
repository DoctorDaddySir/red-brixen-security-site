---
import Base from '../../layouts/Base.astro';
import SocialShare from '../../components/SocialShare.astro';
import { postsFor, formatDate } from '../../lib/posts';
import { BASE } from '../../lib/base';
export function getStaticPaths() {
  return postsFor('writeups').map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, frontmatter: meta } = post;
---

<Base
  title={`${meta.title} | Red Brixen Security`}
  description={meta.description}
  image={meta.preview_image}
  imageAlt={meta.preview_image_alt}
  type="article"
>
  <article class="shell writing-post">
    <header class="writing-hero">
      <a class="text-link" href={BASE + '/writeups/'}>
        ← All writeups
      </a>
      <p class="eyebrow">
        {meta.platform ?? 'SECURITY ARTICLE'} ·{' '}
        <time datetime={String(meta.date)}>{formatDate(meta.date)}</time>
      </p>
      <h1>{meta.title}</h1>
      <p class="lead">{meta.description}</p>
      <p>By Trent Shelton</p>
    </header>
    <div class="post-body">
      {meta.preview_image && meta.preview_in_article !== false && (
        <img
          src={BASE + meta.preview_image}
          alt={meta.preview_image_alt ?? ''}
          class="post-preview-image"
          loading="lazy"
          decoding="async"
          width="1200"
          height="630"
        />
      )}
      <Content />
    </div>
    <SocialShare />
  </article>
</Base>

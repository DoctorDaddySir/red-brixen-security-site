---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import architecture from '../assets/security-architecture.png';
import ProjectCard from '../components/ProjectCard.astro';
import { capabilities, projects, profile } from '../data/profile';
import { BASE } from '../lib/base';
---

<Base
  title="Trent Shelton — Penetration testing & secure coding | Red Brixen"
  description="Trent Shelton explores the intersection of penetration testing and secure software engineering. Selected work, technical approach, and professional background."
>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="small-rule"></span> TRENT SHELTON / SECURITY & SOFTWARE
      </p>
      <h1>
        Think like an
        <br />
        attacker.
        <br />
        Build like an
        <br />
        <em>engineer.</em>
      </h1>
      <p class="hero-description">
        Penetration testing and secure coding.
        <br />
        Two perspectives on building more resilient systems.
      </p>
      <a class="button" href="#work">
        Explore the work <span aria-hidden="true">↗</span>
      </a>
      <a class="credential-inline" href={profile.credential}>
        OSCP+ certified <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="hero-art">
      <p class="diagram-label">
        <span class="signal-dot"></span> TWO PERSPECTIVES. ONE DISCIPLINE.
      </p>
      <Image
        src={architecture}
        alt=""
        widths={[480, 800, 1200]}
        sizes="(max-width: 720px) 100vw, 50vw"
        width={1200}
        format="webp"
        loading="eager"
        class="architecture-image"
      />
      <div class="diagram-caption">
        <span>EXAMINE THE STRUCTURE</span>
        <span>STRENGTHEN THE FOUNDATION ↗</span>
      </div>
    </div>
    <div class="hero-bottom">
      <span>BASED IN MEMPHIS, TENNESSEE</span>
      <a href="#approach">
        A CLOSER LOOK <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section id="approach" class="approach-section shell section-space">
    <div class="section-heading">
      <p class="eyebrow">01 / THE APPROACH</p>
      <h2>
        Security is stronger
        <br />
        when you see both sides.
      </h2>
      <p>
        An offensive mindset to challenge assumptions.
        <br class="desktop-break" /> An engineering mindset to turn findings
        into better systems.
      </p>
    </div>
    <div class="capabilities-grid">
      {capabilities.map((item) => (
        <article class="capability">
          <div class="capability-top">
            <span class="capability-number">{item.number}</span>
            <span class="eyebrow">{item.label}</span>
            <span class="capability-icon" aria-hidden="true">
              {item.number === '01' ? '↗' : '⌘'}
            </span>
          </div>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <ul class="capability-skills">
            {item.skills.map((skill) => (
              <li>{skill}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
  <section id="work" class="work-section shell section-space">
    <div class="section-heading split-heading">
      <div>
        <p class="eyebrow">02 / SELECTED WORK</p>
        <h2>
          Built to explore.
          <br />
          Designed to be useful.
        </h2>
      </div>
      <p>
        Independent tools and field notes
        <br />
        at the intersection of security and software.
      </p>
    </div>
    <div class="projects-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <div class="engineering-note">
      <span class="eyebrow">FROM THE ENGINEERING SIDE</span>
      <p>
        Secure code review, authorization improvements, and vulnerability
        remediation in enterprise applications.
      </p>
      <a class="text-link" href={BASE + '/about/#experience'}>
        Explore my background <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="about-teaser shell section-space">
    <p class="eyebrow">03 / THE PERSON BEHIND THE WORK</p>
    <div>
      <h2>
        Curiosity drives the testing.
        <br />
        <em>Experience informs the fix.</em>
      </h2>
      <p>
        {profile.introduction} Along the way, I’ve built backend services,
        worked on enterprise integrations, and helped others develop their
        technical skills.
      </p>
      <a class="text-link" href={BASE + '/about/'}>
        Meet Trent <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="shell section-space" aria-labelledby="writing-heading">
    <p class="eyebrow">04 / NOTES & PERSPECTIVES</p>
    <h2 id="writing-heading">Explore. Understand. Share.</h2>
    <div class="writing-gateways">
      <article class="writing-card">
        <p class="eyebrow">HACK THE BOX / TRYHACKME</p>
        <h3>
          <a href={BASE + '/writeups/'}>Lab writeups ↗</a>
        </h3>
        <p>The reasoning, techniques, and lessons behind a challenge.</p>
      </article>
      <article class="writing-card">
        <p class="eyebrow">SECURITY / ENGINEERING</p>
        <h3>
          <a href={BASE + '/articles/'}>Security articles ↗</a>
        </h3>
        <p>
          Ideas and practical perspectives on testing and securing software.
        </p>
      </article>
    </div>
  </section>
  <section id="contact" class="contact-section shell">
    <p class="eyebrow">GOOD WORK STARTS WITH A CONVERSATION</p>
    <div>
      <h2>Let’s compare notes.</h2>
      <a class="button button-outline" href={BASE + '/contact/'}>
        Get in touch <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p>
      <a href={BASE + '/contact/'}>
        Send a message via the contact form <span aria-hidden="true">↗</span>
      </a>
    </p>
  </section>
</Base>

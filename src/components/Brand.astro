---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
import { BASE } from '../lib/base';
---

<a
  href={BASE + '/'}
  class:list={['brand', { compact }]}
  aria-label="Red Brixen Security — home"
>
  <svg aria-hidden="true" viewBox="0 0 32 32" width="32" height="32">
    <path
      fill="currentColor"
      d="M2 4h15v10H2zm18 0h10v10H20zM2 18h10v10H2zm13 0h15v10H15z"
    />
  </svg>
  <span>
    RED BRIXEN<span class="brand-sub">SECURITY</span>
  </span>
</a>

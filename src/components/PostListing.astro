---
import { postsFor, formatDate } from '../lib/posts';
import { BASE } from '../lib/base';
interface Props {
  section: 'writeups' | 'articles';
}
const { section } = Astro.props;
const posts = postsFor(section);

// Group posts by `category`, preserving the newest-first sort within each
// group. Categories appear in first-seen order (the newest post's category
// first). Posts without a category fall into an 'Uncategorized' group.
const groupOrder: string[] = [];
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const category = post.frontmatter.category ?? 'Uncategorized';
  if (!groups.has(category)) {
    groups.set(category, []);
    groupOrder.push(category);
  }
  groups.get(category)!.push(post);
}
// Category section headers only add structure when there is more than one
// category (e.g. the articles index). A single category reads cleanly as a
// flat list (e.g. the writeups index).
const showCategoryHeaders = groupOrder.length > 1;
---

<div class="writing-list">
  {posts.length ? (
    groupOrder.map((category) => (
      <section class="writing-category-group">
        {showCategoryHeaders && (
          <h2 class="writing-category-title">{category}</h2>
        )}
        {groups.get(category)!.map((post) => (
          <article class="writing-card">
            <p class="eyebrow">
              {post.frontmatter.platform ??
                post.frontmatter.category ??
                'SECURITY ARTICLE'}{' '}
              ·{' '}
              <time datetime={String(post.frontmatter.date)}>
                {formatDate(post.frontmatter.date)}
              </time>
            </p>
            <h3>
              <a href={`${BASE}/${section}/${post.slug}/`}>
                {post.frontmatter.title} <span aria-hidden="true">↗</span>
              </a>
            </h3>
            <p>{post.frontmatter.description}</p>
            {post.frontmatter.tags?.length && (
              <ul class="writing-tags" aria-label="Topics">
                {post.frontmatter.tags.map((tag) => (
                  <li>{tag}</li>
                ))}
              </ul>
            )}
          </article>
        ))}
      </section>
    ))
  ) : (
    <div class="writing-empty">
      <h2>
        {section === 'writeups'
          ? 'Every lab has a lesson.'
          : 'Ideas worth examining.'}
      </h2>
      <p>
        {section === 'writeups'
          ? 'HTB and THM writeups will appear here as they’re published, with the reasoning behind each step and lessons to take into the next challenge.'
          : 'Articles on application security, penetration testing, and secure engineering will appear here as they’re published.'}
      </p>
      <a class="text-link" href={BASE + '/#work'}>
        Explore my current projects <span aria-hidden="true">↗</span>
      </a>
    </div>
  )}
</div>

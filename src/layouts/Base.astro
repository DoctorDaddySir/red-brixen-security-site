---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { BASE } from '../lib/base';
interface Props {
  title: string;
  description: string;
  resume?: boolean;
  noindex?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
}
const {
  title,
  description,
  resume = false,
  noindex = false,
  image,
  imageAlt,
  type = 'website',
} = Astro.props;
const site = Astro.site ?? new URL('https://redbrixen.com');
const canonical = new URL(Astro.url.pathname, site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Red Brixen Security" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && (
      <>
        <meta property="og:image" content={new URL(image, site).href} />
        <meta property="og:image:alt" content={imageAlt ?? ''} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={new URL(image, site).href} />
        <meta name="twitter:image:alt" content={imageAlt ?? ''} />
      </>
    )}
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#17191a" />
    <link rel="icon" type="image/svg+xml" href={BASE + '/favicon.svg'} />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('rb-theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
  </head>
  <body class:list={[{ 'resume-page': resume }]}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
